# Copy this file to .env and fill in the values. The file .env is git-ignored: never commit it.
# Each variable below is read by `mb2e serve`. A secret may also come from a file: set NAME_FILE
# instead of NAME (for example a Docker secret), never both.

# --- Required ---
# The repository that holds the notes, and the repository that GitHub Pages serves.
MB2E_SOURCE_REPO_URL=https://github.com/OWNER/NOTES
MB2E_TARGET_REPO_URL=https://github.com/OWNER/OWNER.github.io
# The secret of the GitHub webhook: at least 32 characters.
MB2E_WEBHOOK_SECRET=change-me-to-a-random-string-of-32-or-more-characters
# A fine-grained token. One token for both repositories, or set the two tokens below instead.
MB2E_GITHUB_TOKEN=github_pat_REPLACE_ME
# MB2E_SOURCE_TOKEN=github_pat_REPLACE_ME_READ_ONLY
# MB2E_TARGET_TOKEN=github_pat_REPLACE_ME_READ_WRITE
# The author of the commits in the target repository.
MB2E_GIT_USER_NAME=mb2e
MB2E_GIT_USER_EMAIL=mb2e@example.com

# --- Optional: the dashboard. Set all three or none; none switches the dashboard and its login off. ---
# The one GitHub login that may sign in, and the GitHub OAuth App (callback: https://<your-host>/login/oauth2/code/github).
# MB2E_DASHBOARD_ALLOWED_LOGIN=OWNER
# MB2E_DASHBOARD_OAUTH_CLIENT_ID=Iv1.REPLACE_ME
# MB2E_DASHBOARD_OAUTH_CLIENT_SECRET=REPLACE_ME
# The folder of the built UI; the image puts it here. Change it only outside the image.
# MB2E_DASHBOARD_FILES=/opt/mb2e/dashboard

# --- Optional (the defaults are shown) ---
# MB2E_SOURCE_BRANCH=main
# MB2E_SOURCE_SUBDIR=
# MB2E_TARGET_BRANCH=main
# MB2E_WORKSPACE=/var/lib/mb2e
# MB2E_TEMPLATE_PATH=/opt/mb2e/template/mbs-blog
# MB2E_HTTP_PORT=8080
# MB2E_GIT_NETWORK_TIMEOUT_SECONDS=120
# MB2E_SYNC_ON_START=true
# MB2E_POLL_INTERVAL_SECONDS=0
# MB2E_WEBHOOK_MAX_BODY_BYTES=26214400
# MB2E_TAG=blog-ready
# MB2E_INLINE_TAGS=false
# MB2E_DEFAULT_NOTE=about
# Set true when the target is not OWNER/OWNER.github.io.
# MB2E_FORCE=false
# MB2E_COMMIT_MESSAGE=chore(content): refresh Knowledge Hub
# MB2E_LOG_FILE=
